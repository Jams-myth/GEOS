# =============================================================================
# SEO/GEO Content Pipeline — Environment Variables
# Copy to .env.local and fill in values before running.
# =============================================================================

# --- Supabase ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_STORAGE_BUCKET=article-media
SUPABASE_PROJECT_ID=<project-ref>

# --- Vercel Revalidation (MUST match live site REVALIDATE_SECRET exactly) ---
VERCEL_REVALIDATE_URL=https://<your-domain>/api/revalidate
VERCEL_REVALIDATE_SECRET=<openssl rand -hex 32>

# --- Inngest ---
INNGEST_EVENT_KEY=<inngest-event-key>
INNGEST_SIGNING_KEY=<inngest-signing-key>

# --- LLMs ---
ANTHROPIC_API_KEY=<anthropic-api-key>
GOOGLE_AI_API_KEY=<google-ai-api-key>
OPENAI_API_KEY=<openai-api-key>
PERPLEXITY_API_KEY=<perplexity-api-key>

# --- Scraping ---
FIRECRAWL_API_KEY=<firecrawl-api-key>
JINA_API_KEY=<jina-api-key-optional>

# --- Indexing ---
SPEEDYINDEX_API_KEY=<speedyindex-api-key>
GOOGLE_INDEXING_SERVICE_ACCOUNT_JSON=<json-string-of-service-account>
INDEXNOW_KEY=<indexnow-key>

# --- SEO / Analytics ---
DATAFORSEO_LOGIN=<dataforseo-login>
DATAFORSEO_PASSWORD=<dataforseo-password>
GOOGLE_SERVICE_ACCOUNT_JSON=<json-string-of-service-account>

# --- Notifications ---
RESEND_API_KEY=<resend-api-key>
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
DISCORD_PUBLIC_KEY=<discord-public-key>
DISCORD_APPLICATION_ID=<discord-application-id>

# --- Security ---
APPROVAL_TOKEN_HMAC_SECRET=<openssl rand -hex 32>

# --- Image Generation ---
FAL_KEY=<fal-ai-api-key>
